<nav class="navbar navbar-expand-md bg-body border-bottom sticky-top">
  <div class="container-fluid">
    <a class="navbar-brand" href="/listings" aria-label="TripNest home">
      <i class="fa-regular fa-compass"></i>
    </a>

    <!-- hamburger menu -->
    <button
      class="navbar-toggler"
      type="button"
      data-bs-toggle="collapse"
      data-bs-target="#navbarNavAltMarkup"
      aria-controls="navbarNavAltMarkup"
      aria-expanded="false"
      aria-label="Toggle navigation"
    >
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
      <div class="navbar-nav">
        <a class="nav-link" href="/listings">Explore</a>
      </div>

      <!-- Primary Search Bar -->
    <div class="navbar-nav ms-auto">
      <form class="d-flex" action="/listings" method="GET" role="search">
        <input class="form-control me-2 primary-search-input" type="search" name="q"
      value="<%= locals.searchQuery || '' %>"
      placeholder="Search destinations"
      aria-label="Search destinations"
      maxlength="100" >
        <button class="btn btn-danger primary-search-button" type="submit"><i class="fa-solid fa-magnifying-glass"></i>Search</button>
      </form>
    </div>

      <div class="navbar-nav ms-auto">
        <a class="nav-link" href="/listings/new">Add New Listing</a>
        <% if (!currUser) { %>
          <a class="nav-link" href="/signup"><b>Sign Up</b></a>
          <a class="nav-link" href="/login"><b>Login</b></a>
        <% } else { %>
          <!-- logout is a POST so other sites can't log the user out with a plain link/image -->
          <form action="/logout" method="POST" class="d-flex">
            <button type="submit" class="nav-link border-0 bg-transparent">
              <b>Log Out</b>
            </button>
          </form>
        <% } %>
      </div>
    </div>
  </div>
</nav>
