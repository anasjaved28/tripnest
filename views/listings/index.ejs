<% layout("/layouts/boilerplate") %>

<div class="filters">
  <% for (const c of categories) { %>
    <a
      href="/listings?category=<%= encodeURIComponent(c.name) %>"
      class="filter <%= activeCategory === c.name ? 'active' : '' %>"
    >
      <div><i class="<%= c.icon %>"></i></div>
      <p><%= c.name %></p>
    </a>
  <% } %>

  <% if (activeCategory) { %>
    <a href="/listings" class="filter">
      <div><i class="fa-solid fa-xmark"></i></div>
      <p>Clear</p>
    </a>
  <% } %>
</div>

<div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-3">
  <% for (const listing of allListings) { %>
    <a href="/listings/<%= listing._id %>" class="listing-link"> <!-- redirects to show route -->
      <div class="card col listing-card">
        <img
          src="<%= listing.image.url %>"
          class="card-img-top"
          alt="<%= listing.title %>"
          style="height: 20rem"
        />
        <div class="card-img-overlay"></div> <!-- empty on purpose: style.css turns it into the hover wash -->
        <div class="card-body">
          <p class="card-text">
            <b><%= listing.title %></b><br />
            &#8377;<%= listing.price.toLocaleString("en-IN") %>
          </p>
        </div>
      </div>
    </a>
  <% } %>
</div>

<% if (allListings.length === 0) { %>
  <p class="mt-4">No listings in this category yet.</p>
<% } %>
